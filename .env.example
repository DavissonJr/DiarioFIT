# String de conexão do Neon (use a opção "Pooled connection")
DATABASE_URL="postgresql://usuario:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Qualquer frase longa e aleatória. Gere uma com: openssl rand -base64 48
JWT_SECRET="troque-por-uma-frase-longa-e-aleatoria"

# Fuso horário em horas (Brasil = -3)
TZ_OFFSET="-3"
